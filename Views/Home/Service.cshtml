
@{
    ViewData["Title"] = "Service";
}

<div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container text-center py-5">
        <h1 class="display-3 text-white text-uppercase mb-3 animated slideInDown">Services</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb justify-content-center text-uppercase mb-0">
                <li class="breadcrumb-item"><a class="text-white" href="#">Home</a></li>

                <li class="breadcrumb-item text-primary active" aria-current="page">Services</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
            <p class="d-inline-block bg-secondary text-primary py-1 px-4">Services</p>
            <h1 class="text-uppercase">What We Provide</h1>
        </div>
        <div class="row g-4">
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="service-item position-relative overflow-hidden bg-secondary d-flex h-100 p-5 ps-0">
                    <div class="bg-dark d-flex flex-shrink-0 align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <img class="img-fluid" src="~/img/haircut.png" alt="">
                    </div>
                    <div class="ps-4">
                        <h3 class="text-uppercase mb-3">Haircut</h3>
                        <p>We specialize in delivering impeccable haircuts tailored to your unique style. Experience the artistry of our skilled barbers and leave looking and feeling your best.</p>
                        <span class="text-uppercase text-primary">Starts from 100 tk</span>
                    </div>
                    <a class="btn btn-square" asp-controller="temp" asp-action="Create"><i class="fa fa-plus text-primary"></i></a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                <div class="service-item position-relative overflow-hidden bg-secondary d-flex h-100 p-5 ps-0">
                    <div class="bg-dark d-flex flex-shrink-0 align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <img class="img-fluid" src="~/img/beard-trim.png" alt="">
                    </div>
                    <div class="ps-4">
                        <h3 class="text-uppercase mb-3">Beard Trim</h3>
                        <p>Enhance your facial appearance with our professional beard trim service. Our skilled barbers will sculpt and groom your beard to perfection, leaving you with a refined and dapper look. Experience the difference at our barber shop today.</p>
                        <span class="text-uppercase text-primary">Starts from 80 taka</span>
                    </div>
                    <a class="btn btn-square" asp-controller="temp" asp-action="Create"><i class="fa fa-plus text-primary"></i></a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="service-item position-relative overflow-hidden bg-secondary d-flex h-100 p-5 ps-0">
                    <div class="bg-dark d-flex flex-shrink-0 align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <img class="img-fluid" src="~/img/mans-shave.png" alt="">
                    </div>
                    <div class="ps-4">
                        <h3 class="text-uppercase mb-3">Shaving</h3>
                        <p>Indulge in the ultimate grooming experience with our luxurious man's shave service. Relax as our expert barbers provide a close and precise shave, leaving your skin smooth, refreshed, and rejuvenated. Unwind and enjoy the art of traditional shaving at our barber shop.</p>
                        <span class="text-uppercase text-primary">Starts from 120 taka</span>
                    </div>
                    <a class="btn btn-square" asp-controller="temp" asp-action="Create"><i class="fa fa-plus text-primary"></i></a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="service-item position-relative overflow-hidden bg-secondary d-flex h-100 p-5 ps-0">
                    <div class="bg-dark d-flex flex-shrink-0 align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <img class="img-fluid" src="~/img/hair-dyeing.png" alt="">
                    </div>
                    <div class="ps-4">
                        <h3 class="text-uppercase mb-3">Hair Dyeing</h3>
                        <p>
                            Transform your look with our exceptional hair dyeing service. Our experienced colorists will help you achieve vibrant, stunning hair color that suits your personality and style. Step into a world of endless possibilities and let us create a truly captivating hair color for you.
                        </p>
                        <span class="text-uppercase text-primary">Starts from 200 taka</span>
                    </div>
                    <a class="btn btn-square" asp-controller="temp" asp-action="Create"><i class="fa fa-plus text-primary"></i></a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                <div class="service-item position-relative overflow-hidden bg-secondary d-flex h-100 p-5 ps-0">
                    <div class="bg-dark d-flex flex-shrink-0 align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <img class="img-fluid" src="~/img/mustache.png" alt="">
                    </div>
                    <div class="ps-4">
                        <h3 class="text-uppercase mb-3">Facial</h3>
                        <p>Rejuvenate your skin with our invigorating men's facial. Our tailored treatments cleanse, exfoliate, and nourish your skin, leaving it refreshed, hydrated, and youthful. Experience the ultimate relaxation and skincare at our barber shop. Elevate your grooming routine today.</p>
                        <span class="text-uppercase text-primary">Starts from 300 taka</span>
                    </div>
                    <a class="btn btn-square" asp-controller="temp" asp-action="Create"><i class="fa fa-plus text-primary"></i></a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="service-item position-relative overflow-hidden bg-secondary d-flex h-100 p-5 ps-0">
                    <div class="bg-dark d-flex flex-shrink-0 align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <img class="img-fluid" src="~/img/stacking.png" alt="">
                    </div>
                    <div class="ps-4">
                        <h3 class="text-uppercase mb-3">Massage</h3>
                        <p>Indulge in blissful relaxation with our head and body massage service. Our skilled therapists will knead away tension and stress, leaving you feeling revitalized and recharged. Escape the hustle and unwind in our tranquil oasis. Experience the soothing power of massage at our barber shop.</p>
                        <span class="text-uppercase text-primary">Starts from 90 taka</span>
                    </div>
                    <a class="btn btn-square" asp-controller="temp" asp-action="Create"><i class="fa fa-plus text-primary"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>
