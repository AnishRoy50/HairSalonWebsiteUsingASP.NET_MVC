@{
    ViewData["Title"] = "About Us";
}
@*page header start*@
<div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container text-center py-5">
        <h1 class="display-3 text-white text-uppercase mb-3 animated slideInDown">About Us</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb justify-content-center text-uppercase mb-0">
                <li class="breadcrumb-item"><a class="text-white" href="#">Home</a></li>

                <li class="breadcrumb-item text-primary active" aria-current="page">About Us</li>
            </ol>
        </nav>
    </div>
</div>
<!-- Page Header End -->
<!-- About Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                <div class="d-flex flex-column">
                    <img class="img-fluid w-75 align-self-end" src="~/img/BarbarAnish.jpg" alt="Head Barbar Image">
                    <div class="w-50 bg-secondary p-5" style="margin-top: -25%;">
                        <h1 class="text-uppercase text-primary mb-3">25 Years</h1>
                        <h2 class="text-uppercase mb-0">Experience</h2>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <p class="d-inline-block bg-secondary text-primary py-1 px-4">About Us</p>
                <h1 class="text-uppercase mb-4">More Than Just A Haircut. Learn More About Us!</h1>
                <p>Welcome to our hair salon website, your ultimate destination for all your haircare needs. Our beautifully designed website showcases our expertise, passion, and commitment to providing exceptional salon services. Discover our diverse range of hairstyles through stunning imagery that will inspire and ignite your creativity. With a user-friendly interface, you can easily navigate through our services, pricing, and convenient booking options. Explore testimonials from satisfied clients and witness their stunning transformations through before-and-after photos. Our mobile-responsive website ensures a seamless browsing experience, whether you're on your computer or smartphone. Join us on this digital journey and experience the essence of our salon, where style meets innovation.</p>
                <div class="row g-4">
                    <div class="col-md-6">
                        <h3 class="text-uppercase mb-3">Since 1990</h3>
                        <p class="mb-0">
                            With a rich history spanning over three decades, we have been proudly serving our valued clients since 1990. Our longevity speaks volumes about our expertise, trustworthiness, and commitment to delivering exceptional hair services. Join us on this journey as we continue to exceed expectations and create timeless beauty for years to come.
                        </p>
                    </div>
                    <div class="col-md-6">
                        <h3 class="text-uppercase mb-3">1000+ clients</h3>
                        <p class="mb-0">
                            With a strong and loyal clientele of over 1000 satisfied individuals, we take great pride in the trust placed in us by our valued clients. Their unwavering support is a testament to our dedication, expertise, and personalized approach to haircare. Join our community of delighted clients and experience the difference that sets us apart.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- About End -->
<!-- Team Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
            <p class="d-inline-block bg-secondary text-primary py-1 px-4">Our Team</p>
            <h1 class="text-uppercase">Meet Our team</h1>
        </div>
        <div class="row g-4">
            <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="team-item">
                    <div class="team-img position-relative overflow-hidden">
                        <img class="img-fluid" src="~/img/BarberShupto.jpg" alt="">
